# ============================================================
# RAG 私人知识库 — 环境变量配置
# ============================================================
# 复制此文件为 .env（已入 .gitignore，不会提交到仓库）
# 修改配置后需重启 Streamlit 才生效
# cp .env.example .env
# ============================================================


# ============================================================
# 默认后端
# ============================================================
# 可选值：ollama | vllm | siliconflow
# 可在 Streamlit 侧边栏运行时切换，此值为启动默认
# DEFAULT_BACKEND=ollama


# ============================================================
# Ollama 后端（本地 / 远程服务器）
# ============================================================
# Ollama 服务地址
# 本地: http://localhost:11434
# Docker 内: http://ollama:11434
# 远程服务器: http://192.168.1.100:11434
# OLLAMA_BASE_URL=http://localhost:11434

# Ollama 语言模型（需已 pull 到本地）
# 常用: qwen2.5:7b, qwen2.5:32b, qwen3:14b, qwen3:30b, llama3:8b, deepseek-r1:7b
# LLM_MODEL=qwen2.5:7b

# Ollama 嵌入模型（用于文档向量化）
# 常用: bge-m3, nomic-embed-text, mxbai-embed-large
# EMBEDDING_MODEL=bge-m3


# ============================================================
# vLLM 后端（远程 GPU 服务器，兼容 OpenAI API 格式）
# ============================================================
# vLLM 服务地址（需包含 /v1 路径）
# VLLM_BASE_URL=http://192.168.2.60:8888/v1

# vLLM 语言模型（需在 vLLM 服务端已加载）
# VLLM_MODEL=qwen35-35b-a3b

# vLLM 嵌入模型（需在 vLLM 服务端已加载）
# VLLM_EMBEDDING_MODEL=octen-embedding-4b


# ============================================================
# SiliconFlow 后端（硅基流动云 API）
# ============================================================
# SiliconFlow API 地址（一般无需修改）
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# SiliconFlow 语言模型
# 完整列表: https://siliconflow.cn/models
# SILICONFLOW_LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash

# SiliconFlow 嵌入模型
# SILICONFLOW_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B

# SiliconFlow API 密钥（必填，从 https://siliconflow.cn/ 获取）
SILICONFLOW_API_KEY=你的API密钥

# SiliconFlow 重排序模型（Reranker 精排）
# SILICONFLOW_RERANK_MODEL=Qwen/Qwen3-Reranker-4B


# ============================================================
# 文档解析参数
# ============================================================
# 文本分块大小（字符数），越大上下文越完整，但精细度下降
# CHUNK_SIZE=500

# 块间重叠字符数，避免切分切断关键上下文
# CHUNK_OVERLAP=100


# ============================================================
# 检索参数
# ============================================================
# 检索返回的最相关片段数，越大召回越多但噪音也越多
# TOP_K=8


# ============================================================
# 多轮对话记忆
# ============================================================
# 保留的对话轮数，超出则丢弃最早的历史
# MEMORY_WINDOW=5


# ============================================================
# 重排序（Reranker）—— 仅 SiliconFlow 后端支持
# ============================================================
# 是否启用重排序（true / false）
# 启用后：ChromaDB 检索 → Reranker 精排 → LLM 生成
# RERANK_ENABLED=false

# 重排序后保留的文档块数（需小于 TOP_K）
# RERANK_TOP_K=4


# ============================================================
# 日志
# ============================================================
# 日志级别：DEBUG（最详细）| INFO | WARNING | ERROR
# DEBUG 会打印完整 Prompt、检索文档块、LLM 回答全文
# LOG_LEVEL=INFO


# ============================================================
# 目录路径
# ============================================================
# ChromaDB 向量库持久化目录（自动创建）
# CHROMA_DB_DIR=./chroma_db

# 上传文档存放目录
# DOCS_DIR=./docs


# ============================================================
# Docker 部署专属（本地开发不生效）
# ============================================================
# 是否在 Docker 启动时下载翻译模型（en-zh + zh-en，~200MB）
# ENABLE_TRANSLATION=false
